/**
 * =================================================================================
 * Firebase Security Rules for "Know Before You Go" (Tactical Rebuild)
 * =================================================================================
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isVerifiedTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_verifiedTeachers/$(request.auth.uid));
    }

    // =====================================================================
    // User Profiles
    // =====================================================================

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /teacherProfile/{profileId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isOwner(teacherId) || isAdmin();
    }

    // =====================================================================
    // Institutional Data
    // =====================================================================

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isVerifiedTeacher() && request.resource.data.authorTeacherProfileId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.authorTeacherProfileId == request.auth.uid;
      }
    }

    match /locations_costOfLiving/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transport_intel/{countryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =====================================================================
    // Intelligence Pipeline
    // =====================================================================

    match /pending_intel/{reportId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /verified_intel/{intelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =====================================================================
    // Community & Forum
    // =====================================================================

    match /forum_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorTeacherProfileId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorTeacherProfileId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorTeacherProfileId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.authorTeacherProfileId == request.auth.uid;
      }
    }

    // =====================================================================
    // System Config & Metrics
    // =====================================================================

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Application-wide metrics and telemetry.
     * @path /app_metrics/{metricId}
     * @allow (get) Publicly readable for global stats display.
     * @allow (update) Restricted increment logic for telemetry signatures.
     */
    match /app_metrics/{metricId} {
      allow get: if true;
      allow list: if true;
      
      // Allow pulse transmission for page_views dossier
      allow create: if metricId == 'page_views' && isSignedIn();
      
      allow update: if metricId == 'page_views' 
                    && isSignedIn() 
                    // Verify that only the comparisons_made field is being modified
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comparisons_made'])
                    // Verify that the operation is strictly an increment
                    && request.resource.data.comparisons_made > resource.data.comparisons_made;
      
      allow delete: if isAdmin();
    }

    // =====================================================================
    // Roles (DBAC)
    // =====================================================================

    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, write: if isAdmin();
    }

    match /roles_verifiedTeachers/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, write: if isAdmin();
    }

    // =====================================================================
    // Enquiries & Communications
    // =====================================================================
    
    match /enquiries/{enquiryId} {
      allow create: if true; // 🛰️ Public uplink for contact form
      allow read, write: if isAdmin();
    }

    match /teacher_requirements/{countryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /telemetry/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /ikea_intel/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}