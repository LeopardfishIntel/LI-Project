/**
 * =================================================================================
 * Firebase Security Rules for "Know Before You Go" (Tactical Rebuild)
 * =================================================================================
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isVerifiedTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_verifiedTeachers/$(request.auth.uid));
    }

    // =====================================================================
    // User Profiles
    // =====================================================================

    // Keys a normal user must never be able to set on their own users/{uid} document:
    // isAdmin() above trusts role / isAdmin from this document.
    function touchesPrivilegedUserKeys(keys) {
      return keys.hasAny(['role', 'isAdmin', 'customId', 'tier']);
    }

    // Keys a normal user must never be able to mutate on their own teachers/{teacherId} document:
    // Quotas, allowances, counters, tiers, and roles are strictly managed by Server Actions (Admin SDK).
    function touchesPrivilegedTeacherKeys(keys) {
      return keys.hasAny([
        'tier',
        'evaluations_allowance',
        'evaluations_used',
        'daily_evaluations_used',
        'daily_base_quota',
        'bonus_credits',
        'last_quota_reset_date',
        'tier_expires_at',
        'role',
        'isAdmin',
        'isVerified',
        'relocation_pass_active',
        'relocation_pass_expires_at',
        'domestic_baseline_submitted',
        'expedited_uplifts_count',
        'contributions_count',
        'last_contribution_at',
        'last_contribution_date',
        'daily_contributions_count',
        'last_evaluation_at',
        'last_uplift_at'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && !touchesPrivilegedUserKeys(request.resource.data.keys()));
      allow update: if isAdmin() || (isOwner(userId) && !touchesPrivilegedUserKeys(request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
      
      match /teacherProfile/{profileId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() || (isOwner(userId) && request.resource.data.id == userId && !touchesPrivilegedTeacherKeys(request.resource.data.keys()));
        allow update: if isAdmin() || (isOwner(userId) && !touchesPrivilegedTeacherKeys(request.resource.data.diff(resource.data).affectedKeys()));
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(teacherId) &&
        (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isVerified', 'relocation_pass_active', 'relocation_pass_expires_at', 'domestic_baseline_submitted', 'tier_expires_at', 'contributions_count', 'daily_contributions_count', 'last_uplift_at']) &&
         (!request.resource.data.keys().hasAny(['bonus_credits']) || request.resource.data.bonus_credits == 0) &&
         (!request.resource.data.keys().hasAny(['expedited_uplifts_count']) || request.resource.data.expedited_uplifts_count == 0) &&
         (!request.resource.data.keys().hasAny(['daily_base_quota']) || request.resource.data.daily_base_quota <= 20) &&
         (!request.resource.data.keys().hasAny(['tier']) || request.resource.data.tier == 'free') &&
         (!request.resource.data.keys().hasAny(['evaluations_allowance']) || request.resource.data.evaluations_allowance <= 25) &&
         (!request.resource.data.keys().hasAny(['evaluations_used']) || request.resource.data.evaluations_used == 0) &&
         (!request.resource.data.keys().hasAny(['daily_evaluations_used']) || request.resource.data.daily_evaluations_used == 0))
      );
      allow update: if isAdmin() || (
        isOwner(teacherId) && !touchesPrivilegedTeacherKeys(request.resource.data.diff(resource.data).affectedKeys())
      );
      allow delete: if isAdmin();
    }

    // =====================================================================
    // Institutional Data
    // =====================================================================

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isVerifiedTeacher() && request.resource.data.authorTeacherProfileId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.authorTeacherProfileId == request.auth.uid;
      }
    }

    match /locations_costOfLiving/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transport_intel/{countryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =====================================================================
    // Intelligence Pipeline
    // =====================================================================

    match /pending_intel/{reportId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /verified_intel/{intelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =====================================================================
    // Community & Forum
    // =====================================================================

    match /forum_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorTeacherProfileId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorTeacherProfileId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorTeacherProfileId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.authorTeacherProfileId == request.auth.uid;
      }
    }

    // =====================================================================
    // System Config & Metrics
    // =====================================================================

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Application-wide metrics and telemetry.
     * @path /app_metrics/{metricId}
     * @allow (get) Publicly readable for global stats display.
     * @allow (update) Restricted increment logic for telemetry signatures.
     */
    match /app_metrics/{metricId} {
      allow get: if true;
      allow list: if true;
      
      // Allow pulse transmission for page_views dossier
      allow create: if metricId == 'page_views' && isSignedIn();
      
      allow update: if metricId == 'page_views' 
                    && isSignedIn() 
                    // Verify that only the comparisons_made field is being modified
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comparisons_made'])
                    // Verify that the operation is strictly an increment
                    && request.resource.data.comparisons_made > resource.data.comparisons_made;
      
      allow delete: if isAdmin();
    }

    // =====================================================================
    // Roles (DBAC)
    // =====================================================================

    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, write: if isAdmin();
    }

    match /roles_verifiedTeachers/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, write: if isAdmin();
    }

    // =====================================================================
    // Enquiries & Communications
    // =====================================================================
    
    match /enquiries/{enquiryId} {
      allow create: if true; // 🛰️ Public uplink for contact form
      allow read, write: if isAdmin();
    }

    match /teacher_requirements/{countryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /telemetry/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /ikea_intel/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // search_cache is only used by server code (Admin SDK, which ignores these rules).
    match /search_cache/{docId} {
      allow read, write: if isAdmin();
    }

    // =====================================================================
    // Jobs & Featured Cache Rules
    // =====================================================================
    match /featured_jobs_cache/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{path=**}/jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}